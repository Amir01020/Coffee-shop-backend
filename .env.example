# Скопируйте в .env и заполните реальными значениями. .env в git не попадает.

# Сеть. На проде слушаем только локальный интерфейс — наружу отдаёт nginx.
HOST=127.0.0.1
PORT=3000

# База данных
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=coffee
DB_PASSWORD=
DB_NAME=coffee_shop

# Секрет для подписи JWT. Сгенерировать: openssl rand -hex 32
JWT_SECRET=
